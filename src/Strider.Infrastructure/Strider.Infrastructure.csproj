<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Strider.Core\Strider.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- F-009: SQLCipher for at-rest database encryption -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
  </ItemGroup>

  <ItemGroup>
    <!-- F-013 + F-018: Migrations as embedded resources — no inline Schema.sql duplication -->
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
    <!-- F-010: TipTap editor HTML as embedded resource -->
    <EmbeddedResource Include="Editor\tiptap-editor.html" />
  </ItemGroup>

  <PropertyGroup>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\..\packages</RestorePackagesPath>
  </PropertyGroup>

</Project>
