<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Strider.UI.ViewModels"
        xmlns:domain="using:Strider.Core.Domain"
        x:Class="Strider.UI.Views.ComposeWindow"
        x:DataType="vm:ComposeViewModel"
        Title="{Binding WindowTitle}"
        Width="720" Height="600"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <!-- v0.1: plain-text composer, fully wired to ComposeViewModel.
         Rich editor toolbar returns with the TipTap WebView (F-010 full).
         No emoji in XAML (F-027). -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="16,10"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="Cancel" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="2" Content="Send" Classes="accent" Width="100"
                        Command="{Binding SendCommand}"/>
            </Grid>
        </Border>

        <DockPanel Margin="16,12">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="From" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:Account">
                            <TextBlock Text="{Binding Email}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="To" FontSize="12" Opacity="0.6" VerticalAlignment="Bottom"/>
                    <Button Grid.Column="1" Content="Cc / Bcc" FontSize="12" Padding="6,2"
                            Command="{Binding ToggleCcBccCommand}"/>
                </Grid>
                <TextBox Text="{Binding To}" Watermark="recipient@example.com, other@example.com"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8"
                        IsVisible="{Binding ShowCcBcc}">
                <TextBlock Text="Cc" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Cc}"/>
                <TextBlock Text="Bcc" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Bcc}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="Subject" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Subject}" Watermark="Subject" FontWeight="SemiBold"/>
            </StackPanel>

            <TextBox Text="{Binding BodyPlain}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Watermark="Write your message..."
                     FontSize="14"
                     MinHeight="200"/>
        </DockPanel>
    </DockPanel>
</Window>
