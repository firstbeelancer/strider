<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Strider.UI.ViewModels"
        xmlns:domain="using:Strider.Core.Domain"
        xmlns:abs="using:Strider.Core.Abstractions"
        x:Class="Strider.UI.Views.ComposeWindow"
        x:DataType="vm:ComposeViewModel"
        Title="{Binding WindowTitle}"
        Width="720" Height="600"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <!-- v0.1: plain-text composer, fully wired to ComposeViewModel.
         Rich editor toolbar returns with the TipTap WebView (F-010 full).
         No emoji in XAML (F-027). -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="16,10"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Content="Attach" Margin="0,0,8,0"
                        Command="{Binding AddAttachmentCommand}"/>
                <Button Grid.Column="1" Content="Save draft" Margin="0,0,8,0"
                        Command="{Binding SaveDraftCommand}"/>
                <Button Grid.Column="1" Content="AI draft" Margin="90,0,8,0"
                        Command="{Binding AiDraftCommand}"
                        ToolTip.Tip="Draft this reply with AI (needs a provider in Settings)"/>
                <Button Grid.Column="1" Content="Polish" Margin="170,0,8,0"
                        Command="{Binding AiImproveCommand}"
                        ToolTip.Tip="Grammar and clarity pass over the body"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.7"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AiStatus}" FontSize="11" Opacity="0.6"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Cancel" Margin="8,0"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="4" Content="Send" Classes="accent" Width="100"
                        Command="{Binding SendCommand}"/>
            </Grid>
        </Border>

        <DockPanel Margin="16,12">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="From" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:Account">
                            <TextBlock Text="{Binding Email}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8"
                        IsVisible="{Binding Signatures.Count}">
                <TextBlock Text="Signature" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{Binding Signatures}"
                          SelectedItem="{Binding SelectedSignature}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:Signature">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="To" FontSize="12" Opacity="0.6" VerticalAlignment="Bottom"/>
                    <Button Grid.Column="1" Content="Cc / Bcc" FontSize="12" Padding="6,2"
                            Command="{Binding ToggleCcBccCommand}"/>
                </Grid>
                <TextBox Text="{Binding To}" PlaceholderText="recipient@example.com, other@example.com"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8"
                        IsVisible="{Binding ShowCcBcc}">
                <TextBlock Text="Cc" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Cc}"/>
                <TextBlock Text="Bcc" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Bcc}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="Subject" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Subject}" PlaceholderText="Subject" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4"
                        IsVisible="{Binding AttachmentsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding AttachmentsSummary}" FontSize="12" Opacity="0.6"/>
                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="abs:AttachmentData">
                            <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Filename}" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Content="x" Padding="4,0" FontSize="11"
                                            Command="{Binding $parent[Window].((vm:ComposeViewModel)DataContext).RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBox Text="{Binding BodyPlain}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Write your message..."
                     FontSize="14"
                     MinHeight="200"/>
        </DockPanel>
    </DockPanel>
</Window>
