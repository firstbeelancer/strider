<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Strider.UI.ViewModels"
        xmlns:domain="using:Strider.Core.Domain"
        xmlns:abs="using:Strider.Core.Abstractions"
        xmlns:conv="using:Strider.UI.Converters"
        xmlns:r="using:Strider.UI.Rendering"
        x:Class="Strider.UI.Views.ComposeWindow"
        x:DataType="vm:ComposeViewModel"
        Title="{Binding WindowTitle}"
        Width="720" Height="600"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush"/>
    </Window.Resources>

    <!-- Wave 6: the body is edited as text but formatted per selection (colour,
         highlight, font, size, bold/italic/underline) and sent as HTML with a
         text/plain fallback. Preview uses the same in-process HTML renderer as
         the reader. No emoji in XAML (F-027). -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="16,10"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Content="Attach" Margin="0,0,8,0"
                        Command="{Binding AddAttachmentCommand}"/>
                <Button Grid.Column="1" Content="Save draft" Margin="0,0,8,0"
                        Command="{Binding SaveDraftCommand}"/>
                <Button Grid.Column="1" Content="AI draft" Margin="90,0,8,0"
                        Command="{Binding AiDraftCommand}"
                        ToolTip.Tip="Draft this reply with AI (needs a provider in Settings)"/>
                <Button Grid.Column="1" Content="Polish" Margin="170,0,8,0"
                        Command="{Binding AiImproveCommand}"
                        ToolTip.Tip="Grammar and clarity pass over the body"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.7"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AiStatus}" FontSize="11" Opacity="0.6"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Cancel" Margin="8,0"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="4" Content="Send" Classes="accent" Width="100"
                        Command="{Binding SendCommand}"/>
            </Grid>
        </Border>

        <DockPanel Margin="16,12">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="From" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:Account">
                            <TextBlock Text="{Binding Email}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8"
                        IsVisible="{Binding Signatures.Count}">
                <TextBlock Text="Signature" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{Binding Signatures}"
                          SelectedItem="{Binding SelectedSignature}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:Signature">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Insert signature" FontSize="11" Padding="6,2"
                            Command="{Binding InsertSignatureCommand}"/>
                    <!-- ТЗ F4.36: a signature may go out as signature.html instead of inline. -->
                    <CheckBox Content="Send as signature.html attachment" FontSize="11"
                              IsChecked="{Binding SignatureAsAttachment}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="To" FontSize="12" Opacity="0.6" VerticalAlignment="Bottom"/>
                    <Button Grid.Column="1" Content="Cc / Bcc" FontSize="12" Padding="6,2"
                            Command="{Binding ToggleCcBccCommand}"/>
                </Grid>
                <TextBox Text="{Binding To}" PlaceholderText="recipient@example.com, other@example.com"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8"
                        IsVisible="{Binding ShowCcBcc}">
                <TextBlock Text="Cc" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Cc}"/>
                <TextBlock Text="Bcc" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Bcc}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="Subject" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{Binding Subject}" PlaceholderText="Subject" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4"
                        IsVisible="{Binding AttachmentsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding AttachmentsSummary}" FontSize="12" Opacity="0.6"/>
                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="abs:AttachmentData">
                            <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Filename}" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Content="x" Padding="4,0" FontSize="11"
                                            Command="{Binding $parent[Window].((vm:ComposeViewModel)DataContext).RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <DockPanel Grid.Column="0">
                <!-- Formatting toolbar (Wave 6). Works on the selected words. -->
                <Border DockPanel.Dock="Top" Padding="0,0,0,6">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="B" FontWeight="Bold" Width="30" Margin="0,0,4,4"
                                Command="{Binding BoldCommand}" ToolTip.Tip="Bold the selection"/>
                        <Button Content="I" FontStyle="Italic" Width="30" Margin="0,0,4,4"
                                Command="{Binding ItalicCommand}" ToolTip.Tip="Italicise the selection"/>
                        <Button Width="30" Margin="0,0,8,4"
                                Command="{Binding UnderlineCommand}" ToolTip.Tip="Underline the selection">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </Button>
                        <ComboBox ItemsSource="{Binding FontFamilies}" Width="150" Margin="0,0,4,4"
                                  SelectedItem="{Binding SelectedFontFamily}"
                                  PlaceholderText="Font"/>
                        <ComboBox ItemsSource="{Binding FontSizes}" Width="70" Margin="0,0,8,4"
                                  SelectedItem="{Binding SelectedFontSize}"
                                  PlaceholderText="Size"/>
                        <TextBlock Text="Colour" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="0,0,4,0"/>
                        <ItemsControl ItemsSource="{Binding Palette}" Margin="0,0,8,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Width="18" Height="18" Padding="0" CornerRadius="9"
                                            BorderThickness="1"
                                            Background="{Binding Converter={StaticResource HexBrush}}"
                                            Command="{Binding $parent[Window].((vm:ComposeViewModel)DataContext).ApplyColorCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Highlight" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="0,0,4,0"/>
                        <ItemsControl ItemsSource="{Binding Highlights}" Margin="0,0,8,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Width="18" Height="18" Padding="0" CornerRadius="9"
                                            BorderThickness="1"
                                            Background="{Binding Converter={StaticResource HexBrush}}"
                                            Command="{Binding $parent[Window].((vm:ComposeViewModel)DataContext).ApplyHighlightCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Clear" FontSize="11" Padding="6,2" Margin="0,0,4,4"
                                Command="{Binding ClearFormattingCommand}"
                                ToolTip.Tip="Remove formatting from the selection"/>
                        <ToggleButton Content="Preview" FontSize="11" Padding="6,2" Margin="0,0,0,4"
                                      IsChecked="{Binding ShowPreview}"/>
                    </WrapPanel>
                </Border>

                <TextBox x:Name="BodyEditor"
                         Text="{Binding BodyPlain}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Write your message..."
                         FontSize="14"
                         MinHeight="200"/>
              </DockPanel>

              <!-- Live HTML preview: exactly what the recipient receives. -->
              <Border Grid.Column="1" Width="320" Margin="8,0,0,0"
                      IsVisible="{Binding ShowPreview}"
                      Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="8">
                  <ScrollViewer>
                      <r:HtmlTextBlock Html="{Binding PreviewHtml}" TextWrapping="Wrap" FontSize="13"/>
                  </ScrollViewer>
              </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
