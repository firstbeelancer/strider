<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Strider.UI.ViewModels"
        xmlns:domain="using:Strider.Core.Domain"
        xmlns:conv="using:Strider.UI.Converters"
        xmlns:r="using:Strider.UI.Rendering"
        x:Class="Strider.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="760" Height="640"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush"/>
        <conv:FlagColorToBrushConverter x:Key="FlagBrush"/>
    </Window.Resources>

    <!-- Wave 5: every control here is bound to SettingsViewModel. The previous
         version was a mock-up — hard-coded texts, dead buttons, fake accounts.
         Wave 6 adds the "Fonts & Text" and "Flags" tabs. -->
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="Settings" FontWeight="Bold" FontSize="16"/>
        </Border>

        <TabControl Margin="16">
            <!-- ==== General ==== -->
            <TabItem Header="General">
                <StackPanel Spacing="16" Margin="0,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Theme" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                  HorizontalAlignment="Left" MinWidth="160"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Language" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                                  HorizontalAlignment="Left" MinWidth="160"/>
                        <TextBlock Text="Interface translations ship in v0.2." FontSize="11" Opacity="0.5"/>
                    </StackPanel>

                    <CheckBox Content="Show notifications for new messages"
                              IsChecked="{Binding ShowNotifications}"/>

                    <Button Content="Save" Command="{Binding SaveGeneralCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding GeneralStatus}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <!-- ==== Accounts ==== -->
            <TabItem Header="Accounts">
                <DockPanel Margin="0,16">
                    <Button DockPanel.Dock="Bottom" Content="Remove selected account"
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding DeleteAccountCommand}"
                            CommandParameter="{Binding SelectedAccount}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Connected mailboxes" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                 MinHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:Account">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Email}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Opacity="0.6"
                                                   Text="{Binding ImapHost, StringFormat='IMAP: {0}'}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Add another mailbox from the main window toolbar."
                                   FontSize="11" Opacity="0.5"/>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <!-- ==== Signatures ==== -->
            <TabItem Header="Signatures">
                <Grid Margin="0,16" ColumnDefinitions="200,*">
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <Button DockPanel.Dock="Bottom" Content="New signature" Margin="0,8,0,0"
                                Command="{Binding NewSignatureCommand}"/>
                        <ListBox ItemsSource="{Binding Signatures}"
                                 SelectedItem="{Binding SelectedSignature}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:Signature">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="[Default]" FontSize="11"
                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                   IsVisible="{Binding IsDefault}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Name" FontSize="12" Opacity="0.6"/>
                        <TextBox Text="{Binding SignatureName}" PlaceholderText="Work"/>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="Write in HTML" IsChecked="{Binding SignatureIsHtml}"
                                      ToolTip.Tip="Colours, bold text, links and a logo via &lt;img src=&quot;cid:logo&quot;&gt;"/>
                            <CheckBox Content="Send as signature.html attachment"
                                      IsChecked="{Binding SignatureAttachAsFile}"
                                      ToolTip.Tip="The recipient gets the signature as a .html file instead of inline text"/>
                        </StackPanel>

                        <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                   Text="HTML: bold/italic, colours and fonts are kept. Inline images work through cid: references (e.g. &lt;img src=&quot;cid:logo&quot; width=&quot;120&quot;&gt;)."/>

                        <TextBox Text="{Binding SignatureText}" AcceptsReturn="True" Height="140"
                                 TextWrapping="Wrap"
                                 PlaceholderText="Best regards, ... (HTML allowed when the box above is ticked)"/>

                        <CheckBox Content="Use as default for new messages"
                                  IsChecked="{Binding SignatureIsDefault}"/>

                        <!-- Live preview of the HTML signature (Wave 6). -->
                        <Border Padding="8" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                IsVisible="{Binding SignatureIsHtml}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Preview" FontSize="11" Opacity="0.6"/>
                                <r:HtmlTextBlock Html="{Binding SignaturePreviewHtml}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save" Classes="accent" Command="{Binding SaveSignatureCommand}"/>
                            <Button Content="Delete" Command="{Binding DeleteSignatureCommand}"
                                    CommandParameter="{Binding SelectedSignature}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SignatureStatus}" FontSize="12" Opacity="0.7"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==== Fonts & Text (Wave 6) ==== -->
            <TabItem Header="Fonts &amp; Text">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,16">
                        <TextBlock Text="Default style for new messages" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Font" VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FontFamilies}"
                                      SelectedItem="{Binding TextFontFamily}" HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" VerticalAlignment="Center"
                                       Margin="0,8,12,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FontSizes}"
                                      SelectedItem="{Binding TextFontSize}" Margin="0,8,0,0"
                                      HorizontalAlignment="Left" MinWidth="100"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Text colour" FontSize="12" Opacity="0.6"/>
                            <ItemsControl ItemsSource="{Binding Palette}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Width="22" Height="22" Padding="0" CornerRadius="11" BorderThickness="1"
                                                Background="{Binding Converter={StaticResource HexBrush}}"
                                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).PickTextColorCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding TextColor, StringFormat='Current: {0}'}" FontSize="11" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Highlight colour (optional)" FontSize="12" Opacity="0.6"/>
                            <ItemsControl ItemsSource="{Binding Palette}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Width="22" Height="22" Padding="0" CornerRadius="11" BorderThickness="1"
                                                Background="{Binding Converter={StaticResource HexBrush}}"
                                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).PickHighlightColorCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="No highlight" FontSize="11" Padding="6,2" HorizontalAlignment="Left"
                                    Command="{Binding ClearHighlightColorCommand}"/>
                        </StackPanel>

                        <Border Padding="10" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Preview" FontSize="11" Opacity="0.6"/>
                                <r:HtmlTextBlock Html="{Binding TextStylePreview}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Save text style" Classes="accent" HorizontalAlignment="Left"
                                Command="{Binding SaveTextStyleCommand}"/>

                        <Separator/>

                        <TextBlock Text="Your own fonts" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                   Text="Add any .ttf / .otf / .ttc file. It is copied into %LocalAppData%&#92;StriderMail&#92;fonts and offered in every font list, in Settings and in the composer."/>
                        <ListBox x:Name="CustomFontsList" ItemsSource="{Binding CustomFonts}" MinHeight="90">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:CustomFont">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Family}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FilePath}" FontSize="11" Opacity="0.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add font..." Command="{Binding AddFontCommand}"/>
                            <Button Content="Remove selected" Command="{Binding RemoveFontCommand}"
                                    CommandParameter="{Binding #CustomFontsList.SelectedItem}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding TextStyleStatus}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==== Coloured flags & rules (Wave 6) ==== -->
            <TabItem Header="Flags">
                <Grid Margin="0,16" ColumnDefinitions="240,*">
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                            <Button Content="New rule" Command="{Binding NewRuleCommand}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Up" Command="{Binding MoveRuleCommand}" CommandParameter="up"/>
                                <Button Content="Down" Command="{Binding MoveRuleCommand}" CommandParameter="down"/>
                                <Button Content="Delete" Command="{Binding DeleteRuleCommand}"
                                        CommandParameter="{Binding SelectedRule}"/>
                            </StackPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding FlagRules}" SelectedItem="{Binding SelectedRule}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:FlagRule">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,2,8,2"
                                                Background="{Binding Color, Converter={StaticResource FlagBrush}}"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplaySummary}" FontSize="11" Opacity="0.6"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="disabled" FontSize="11" Opacity="0.5"
                                                       IsVisible="{Binding !IsEnabled}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Rule" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Rules run after every sync and colour incoming mail. The first matching rule wins; a colour you set by hand is never overwritten."/>

                            <TextBlock Text="Name" FontSize="12" Opacity="0.6"/>
                            <TextBox Text="{Binding RuleName}" PlaceholderText="Invoices"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Look at" FontSize="12" Opacity="0.6"/>
                                    <ComboBox ItemsSource="{Binding RuleFields}" SelectedItem="{Binding RuleField}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Compare" FontSize="12" Opacity="0.6"/>
                                    <ComboBox ItemsSource="{Binding RuleOperators}" SelectedItem="{Binding RuleOperator}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Pattern" FontSize="12" Opacity="0.6"/>
                            <TextBox Text="{Binding RulePattern}" PlaceholderText="billing@example.com"/>

                            <TextBlock Text="Flag colour" FontSize="12" Opacity="0.6"/>
                            <ItemsControl ItemsSource="{Binding RuleColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="domain:FlagColor">
                                        <Button Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1"
                                                Background="{Binding Converter={StaticResource FlagBrush}}"
                                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).PickRuleColorCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding RuleColor, StringFormat='Selected: {0}'}" FontSize="11" Opacity="0.6"/>

                            <CheckBox Content="Enabled" IsChecked="{Binding RuleIsEnabled}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save rule" Classes="accent" Command="{Binding SaveRuleCommand}"/>
                                <Button Content="Apply now" Command="{Binding ApplyRulesNowCommand}"
                                        ToolTip.Tip="Recolour the mail already downloaded for the selected account"/>
                            </StackPanel>

                            <TextBlock Text="{Binding RuleStatus}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ==== AI ==== -->
            <TabItem Header="AI">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,16">
                        <TextBlock Text="Bring your own key. The key is stored in the OS keychain (DPAPI / libsecret), never in the database."
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Provider" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AiProviders}" SelectedItem="{Binding AiProvider}"
                                      HorizontalAlignment="Left" MinWidth="180"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Model" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AiModels}" SelectedItem="{Binding AiModel}"
                                      IsEditable="True" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Base URL (custom / self-hosted only)" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding AiBaseUrl}" PlaceholderText="https://my-host/v1"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="API key" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding AiApiKey}" PasswordChar="*"
                                     PlaceholderText="Sk-... (leave empty to keep the stored key)"/>
                            <TextBlock Text="A key is already stored in the keychain."
                                       FontSize="11" Foreground="{DynamicResource SystemAccentColor}"
                                       IsVisible="{Binding HasStoredApiKey}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save" Classes="accent" Command="{Binding SaveAiSettingsCommand}"/>
                            <Button Content="Test connection" Command="{Binding TestAiConnectionCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding AiStatus}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==== PGP ==== -->
            <TabItem Header="PGP">
                <StackPanel Spacing="12" Margin="0,16">
                    <TextBlock Text="PGP key management" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="The crypto layer (BouncyCastle, RSA 4096, AES-256) is implemented and unit-tested, but key management UI (generate / import / export, trust levels) is scheduled for v0.2 — ТЗ F7.2–F7.9."/>
                    <TextBlock Text="Incoming and outgoing PGP status is already shown in the message reader."
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
