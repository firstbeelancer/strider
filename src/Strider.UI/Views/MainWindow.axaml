<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Strider.UI.ViewModels"
        xmlns:domain="using:Strider.Core.Domain"
        xmlns:conv="using:Strider.UI.Converters"
        xmlns:r="using:Strider.UI.Rendering"
        x:Class="Strider.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Strider Mail"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush"/>
        <conv:FlagColorToBrushConverter x:Key="FlagBrush"/>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <!-- ZAI F-027: emoji removed. Inter font does not bundle emoji glyphs; rendering
             them on a fresh Avalonia install either hangs the rendering loop (when
             font fallback is missing on Linux) or produces ugly tofu boxes. The
             design system prefers real icons over emoji; v0.2 will add Lucide. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add Account" Command="{Binding AddAccountCommand}"/>
                    <Button Content="Sync" Command="{Binding SyncCommand}" IsEnabled="{Binding !IsSyncing}"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="16,0" ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBox Grid.Column="0" CornerRadius="4"
                             Text="{Binding MessageList.SearchQuery}"
                             PlaceholderText="Search: from:alice subject:invoice has:attachment is:unread">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding MessageList.SearchCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <CheckBox Grid.Column="1" Content="All mail" Margin="8,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding MessageList.SearchAllFolders}"
                              ToolTip.Tip="Search every folder instead of the open one"/>
                    <Button Grid.Column="2" Content="Find" Margin="8,0,0,0"
                            Command="{Binding MessageList.SearchCommand}"/>
                    <Button Grid.Column="3" Content="Clear" Margin="4,0,0,0"
                            IsVisible="{Binding MessageList.IsSearchResult}"
                            Command="{Binding MessageList.ClearSearchCommand}"/>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Calendar" Command="{Binding OpenCalendarCommand}"/>
                    <Button Content="Compose" Command="{Binding ComposeNewCommand}"/>
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle theme"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Opacity="0.7"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Accounts.Count, StringFormat='{}{0} account(s)'}"
                           FontSize="12" Opacity="0.5"/>
            </Grid>
        </Border>

        <Panel>
        <!-- First run: no accounts -> explain and offer setup instead of an empty frame. -->
        <Border ZIndex="10" IsVisible="{Binding HasNoAccounts}"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
                <TextBlock Text="Welcome to Strider Mail" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Connect your first mailbox. Gmail, Outlook, Yandex, Mail.ru and iCloud are set up automatically; any other IMAP server works with manual settings."
                           TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7"/>
                <Button Content="Add account" Classes="accent" HorizontalAlignment="Center"
                        Padding="24,10" FontSize="15" Command="{Binding AddAccountCommand}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Three-panel layout -->
        <Grid ColumnDefinitions="200,380,*">

            <!-- Left: Folder Tree -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Strider Mail" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentAccount.Email}" FontSize="12" Opacity="0.6" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Folders}"
                             SelectedItem="{Binding SelectedFolder}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderItem">
                                <TextBlock Text="{Binding DisplayName}" Margin="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Center: Message List -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding SelectedFolder.Name}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MessageList.TotalCount, StringFormat='{}{0} msgs'}"
                                       FontSize="12" Opacity="0.5"/>
                        </Grid>
                    </Border>
                    <ListBox ItemsSource="{Binding MessageList.Messages}"
                             SelectedItem="{Binding MessageList.SelectedMessage}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Message">
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="0,0,0,1">
                                  <Grid ColumnDefinitions="4,*">
                                    <!-- Coloured flag: the bar on the left of the row (Wave 6). -->
                                    <Border Grid.Column="0" Margin="0,4" CornerRadius="2"
                                            IsVisible="{Binding HasFlagColor}"
                                            Background="{Binding FlagColorHex, Converter={StaticResource HexBrush}}"/>
                                    <Border Grid.Column="1" Padding="8,6">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemAccentColor}"
                                                     IsVisible="{Binding !IsRead}"/>
                                            <TextBlock Text="{Binding FromName}" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding DateUtc, StringFormat='{}{0:HH:mm}'}"
                                                   FontSize="11" Opacity="0.5"/>
                                        <!-- Flagged mail: the subject itself is painted in the flag colour (Wave 6). -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding Subject}"
                                                   IsVisible="{Binding !HasFlagColor}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" Margin="16,2,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding Subject}"
                                                   IsVisible="{Binding HasFlagColor}"
                                                   Foreground="{Binding FlagColorHex, Converter={StaticResource HexBrush}}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" Margin="16,2,0,0"
                                                   ToolTip.Tip="{Binding FlagColorName, StringFormat='Flag: {0}'}"/>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="8" Margin="16,2,0,0">
                                            <TextBlock Text="Attachment"
                                                       IsVisible="{Binding HasAttachments}" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Text="Starred"
                                                       IsVisible="{Binding IsStarred}" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Text="{Binding AiCategory}" FontSize="11" Opacity="0.6"/>
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                  </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: Message Reader -->
            <Border Grid.Column="2">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding MessageReader.CurrentMessage.Subject}"
                                       FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding MessageReader.CurrentMessage.FromName}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding MessageReader.CurrentMessage.FromAddress}"
                                           FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding MessageReader.CurrentMessage.DateUtc, StringFormat='{}{0:dd MMM yyyy HH:mm}'}"
                                           FontSize="12" Opacity="0.5"/>
                                <!-- Wave 6: the flag colour the message carries, if any. -->
                                <Border IsVisible="{Binding MessageReader.CurrentMessage.HasFlagColor}"
                                        CornerRadius="8" Padding="8,1" VerticalAlignment="Center"
                                        Background="{Binding MessageReader.CurrentMessage.FlagColorHex, Converter={StaticResource HexBrush}}">
                                    <TextBlock Text="{Binding MessageReader.CurrentMessage.FlagColorName}"
                                               FontSize="11" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding MessageReader.PgpStatus}" FontSize="12"
                                       Foreground="{DynamicResource SystemAccentColor}"
                                       IsVisible="{Binding MessageReader.PgpStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="16,8">
                        <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Reply" Command="{Binding MessageReader.ReplyCommand}"/>
                            <Button Content="Reply All" Command="{Binding MessageReader.ReplyAllCommand}"/>
                            <Button Content="Forward" Command="{Binding MessageReader.ForwardCommand}"/>
                            <Button Content="Archive" Command="{Binding MessageList.ArchiveCommand}"
                                    CommandParameter="{Binding MessageReader.CurrentMessage}"
                                    IsEnabled="{Binding MessageReader.HasMessage}"/>
                            <Button Content="Delete" Command="{Binding MessageList.DeleteCommand}"
                                    CommandParameter="{Binding MessageReader.CurrentMessage}"
                                    IsEnabled="{Binding MessageReader.HasMessage}"/>
                            <Button Content="Summarize" Command="{Binding MessageReader.SummarizeCommand}"
                                    IsEnabled="{Binding MessageReader.HasMessage}"
                                    ToolTip.Tip="AI summary of the whole thread"/>
                            <Button Content="Classify" Command="{Binding MessageReader.ClassifyCommand}"
                                    IsEnabled="{Binding MessageReader.HasMessage}"
                                    ToolTip.Tip="AI category for this message"/>
                            <Button Content="Flag" Command="{Binding MessageList.ToggleFlagPickerCommand}"
                                    IsEnabled="{Binding MessageReader.HasMessage}"
                                    ToolTip.Tip="Colour flag for this message"/>
                            <TextBlock Text="{Binding MessageList.StatusMessage}" VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                        <!-- Wave 6: manual colour flags. The command acts on the selected message. -->
                        <ItemsControl ItemsSource="{Binding MessageList.FlagColorChoices}"
                                      IsVisible="{Binding MessageList.IsFlagPickerOpen}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="domain:FlagColor">
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11"
                                            Background="{Binding Converter={StaticResource FlagBrush}}"
                                            BorderThickness="1"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MessageList.SetFlagCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="No flag" FontSize="11" Padding="6,0" HorizontalAlignment="Left"
                                IsVisible="{Binding MessageList.IsFlagPickerOpen}"
                                Command="{Binding MessageList.SetFlagCommand}"
                                CommandParameter="{x:Static domain:FlagColor.None}"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="16,8"
                            IsVisible="{Binding MessageReader.HasAiSummary}"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="AI summary" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                            <SelectableTextBlock Text="{Binding MessageReader.AiSummary}"
                                                 TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="16,4"
                            IsVisible="{Binding MessageReader.AiStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding MessageReader.AiStatus}" FontSize="11" Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="16,8"
                            IsVisible="{Binding MessageReader.CurrentMessage.HasAttachments}"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="4">
                        <TextBlock Text="{Binding MessageReader.AttachmentStatus}" FontSize="11" Opacity="0.7"
                                   IsVisible="{Binding MessageReader.AttachmentStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <ItemsControl ItemsSource="{Binding MessageReader.Attachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="domain:Attachment">
                                    <Border Margin="4" Padding="8,4"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            CornerRadius="4"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Filename}" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Content="Save" Padding="6,0" FontSize="11"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MessageReader.DownloadAttachmentCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="16">
                        <ScrollViewer>
                          <Panel>
                            <!-- Wave 6: HTML is rendered in-process (bold, italic, colours, fonts),
                                 so the formatting the sender chose is actually visible (F4.20). -->
                            <SelectableTextBlock Text="{Binding MessageReader.DisplayText}"
                                       IsVisible="{Binding !MessageReader.DisplayIsHtml}"
                                       TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                            <r:HtmlTextBlock Html="{Binding MessageReader.DisplayHtml}"
                                       IsVisible="{Binding MessageReader.DisplayIsHtml}"
                                       TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                          </Panel>
                        </ScrollViewer>
                    </Border>

                </DockPanel>
            </Border>
        </Grid>
    </Panel>
    </DockPanel>
</Window>
